#, php-format
msgid "Total %s"
msgstr "Total %s"

#: classes/class-ispag-supplier-dashboard.php:190
msgid "Total number of pieces ordered from this supplier during the year."
msgstr "Nombre total de pièces commandées à ce fournisseur au cours de l'année."

#: classes/admin/supplier-stats-page.php:25
msgid "Year"
msgstr "Année"